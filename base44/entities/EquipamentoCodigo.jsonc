{
  "name": "EquipamentoCodigo",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do equipamento (ex: H-32-B1-05-01)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "H",
        "PC",
        "EX",
        "MG",
        "DF",
        "AM",
        "SAV",
        "PCH"
      ],
      "description": "Sigla do tipo de equipamento"
    },
    "predio": {
      "type": "number",
      "default": 32,
      "description": "N\u00famero do pr\u00e9dio (fixo = 32)"
    },
    "bloco": {
      "type": "string",
      "enum": [
        "B1",
        "B2",
        "B3"
      ],
      "description": "Bloco do edif\u00edcio"
    },
    "andar": {
      "type": "string",
      "description": "Andar (n\u00famero ou T para t\u00e9rreo)"
    },
    "numero_equipamento": {
      "type": "number",
      "description": "N\u00famero sequencial do equipamento por conjunto Tipo+Pr\u00e9dio+Bloco+Andar"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou localiza\u00e7\u00e3o espec\u00edfica do equipamento"
    },
    "data_ultima_inspecao": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Conforme",
        "N\u00e3o Conforme",
        "Em Manuten\u00e7\u00e3o"
      ],
      "default": "Conforme"
    },
    "observacoes": {
      "type": "string"
    },
    "responsavel_cadastro": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que cadastrou o c\u00f3digo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "codigo",
    "tipo",
    "predio",
    "bloco",
    "andar",
    "numero_equipamento"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}